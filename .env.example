# WoWyrd — client install environment
#
# Copy to .env, fill in the values below, then: docker compose up -d
# NEVER commit the resulting .env — it contains secrets.

# ── Required ────────────────────────────────────────────────────────────────

# The released version to run — see this repo's README.md "Versions" section for the current
# release. The Docker image tag drops the release's leading "v" (release "v0.3.10" -> image tag
# "0.3.10") -- set this to the number only, e.g. WOWYRD_VERSION=0.3.10, not "v0.3.10". There is no
# `latest` -- pin a specific version deliberately, and change it deliberately.
WOWYRD_VERSION=CHANGE_ME

# PostgreSQL password — generate a real one (e.g. `openssl rand -hex 16`), never reuse a
# value seen in any repo's history.
POSTGRES_PASSWORD=CHANGE_ME

# Bearer token(s) accepted by the API, comma-separated. Generate a real one
# (e.g. `openssl rand -hex 24`) — never reuse a value seen in any repo's history.
API_KEYS=CHANGE_ME

# The dashboard's own read-only key(s), comma-separated. The dashboard web page contains
# this value. Never use a value from API_KEYS here. Generate it the same way.
DASHBOARD_API_KEYS=CHANGE_ME

# ── Safety — do not change without a deliberate reason ──────────────────────

# observe | advisory | enforce. Defaults to "observe" (safe — no automatic blocks) even if
# this line is removed. Only set "enforce" after evidence review and explicit sign-off.
ENFORCEMENT_MODE=observe

# ── Optional ──────────────────────────────────────────────────────────────────

# Set to this machine's real reachable address if the dashboard will be viewed from a
# different machine than it runs on (e.g. an EC2 public IP or ALB hostname).
HOST_IP=

# risk_assessments PII-anonymization pass. Fail-safe by design: leaving this unset skips
# the pass entirely (a warn-logged no-op) rather than anonymizing weakly — set a real key
# (e.g. `openssl rand -hex 32`) before relying on this for real customer data. Rotating it
# later makes already-anonymized customer_ids permanently unmatchable against new ones.
RETENTION_HASH_KEY=

# Minimum age (days) before PII columns are anonymized. Clamped to a 31-day floor
# regardless of this value — the real number is a business/contract decision per deployment.
RETENTION_ANONYMIZE_AFTER_DAYS=180

# Age (days) after which an expired block record has its blocked value redacted. Needs
# RETENTION_HASH_KEY. Default 365, minimum 30.
RETENTION_BLOCK_REDACT_AFTER_DAYS=365

# MaxMind GeoLite2 license key (free, per-account registration at
# https://www.maxmind.com/en/geolite2/signup). Leave unset to skip GeoLite2 enrichment.
MAXMIND_LICENSE_KEY=

# Stripe webhook signing secret, only needed if using POST /v1/ingest/payment-callback.
# That endpoint fails closed (503) rather than accepting unverified callbacks if unset.
STRIPE_WEBHOOK_SECRET=

# Network interface for optional eBPF enforcement (Linux only). Empty = the sensor uses the first
# interface that is not loopback. From 0.3.10, a comma-separated list (up to 8, for example
# eth0,eth1) attaches XDP to each one. If eBPF is unavailable, the app runs in PostgreSQL-only mode.
NETWORK_INTERFACE=

# true = never start the eBPF loader; the app runs in PostgreSQL-only mode (0.3.9 or later).
# From 0.3.9 the loader is tried by default on the Full profile.
WOWYRD_EBPF_DISABLE=false

# true = the app downloads no threat-intel lists and no bundle (0.3.6 or later). Scoring uses
# the entries already stored; they expire 2 days after their last download. See NETWORK.md.
WOWYRD_OFFLINE=false

# Approvers needed for every maker-checker change: 1 or 2 (0.3.6 or later).
# With 1, the proposer can approve their own change. With 2, the proposer cannot, so two other
# operators must approve.
REQUIRED_APPROVALS_DEFAULT=1

# Days before a pending proposal expires (0.3.9 or later). A whole number of 1 or more; default 7.
# Any other value (for example 0 or abc) stops the app at start. Empty = 7.
PROPOSAL_TTL_DAYS=7

# Hours before a managed kernel list (Tor exit list, hijacked-netblock list) that was not updated
# stops enforcing and goes back to observe (0.3.10 or later). Its entries stay in place. A whole
# number of 1 or more; any other value (for example 0 or abc) stops the app at start.
MANAGED_TOR_MAX_LIST_AGE_HOURS=72
MANAGED_HIJACKED_NETBLOCK_MAX_LIST_AGE_HOURS=168

LOG_LEVEL=info
DASHBOARD_PORT=3000
